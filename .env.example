# Azure AD アプリケーション認証情報
# Azure Portal で取得: https://portal.azure.com → Azure Active Directory → アプリの登録
AZURE_CLIENT_ID=your-client-id-here
AZURE_TENANT_ID=consumers        # 個人Outlookの場合は "consumers"、法人は組織のテナントID

# デバイスコードフローの場合は空白のままにする
# クライアント資格情報フロー（自動化）の場合のみ設定
AZURE_CLIENT_SECRET=

# 検索設定
SEARCH_SENDER=銀座アントレサロン
SEARCH_SUBJECT_KEYWORD=請求書
INVOICE_OUTPUT_DIR=invoices
DAYS_BACK=365
